<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.ufw-switcher.Mode">
    <value nick="home" value="0"/>
    <value nick="office" value="1"/>
    <value nick="public" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.ufw-switcher"
          path="/org/gnome/shell/extensions/ufw-switcher/">

    <!-- Desired overall state: firewall on/off -->
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Firewall active</summary>
    </key>

    <!-- Active profile -->
    <key name="mode" enum="org.gnome.shell.extensions.ufw-switcher.Mode">
      <default>'home'</default>
      <summary>Active firewall profile (home, office, public)</summary>
    </key>

    <!--
      Profiles as JSON:
      {
        "defaults": {"incoming": "deny|allow|reject", "outgoing": "allow|deny"},
        "rules": [
          {
            "action":    "allow|deny|reject",
            "direction": "in|out",
            "interface": "",            # e.g. wlan0 (optional)
            "from":      "",            # e.g. 192.168.0.0/24 (optional)
            "to":        "",            # optional
            "proto":     "",            # tcp|udp (optional)
            "port":      "",            # e.g. 22 or 80:90 (optional)
            "comment":   ""
          }
        ]
      }
    -->
    <key name="profile-home" type="s">
      <default><![CDATA['{"defaults":{"incoming":"allow","outgoing":"allow"},"rules":[]}']]></default>
      <summary>"Home" profile (fully trusted: everything allowed)</summary>
    </key>

    <key name="profile-office" type="s">
      <default><![CDATA['{"defaults":{"incoming":"reject","outgoing":"allow"},"rules":[{"action":"allow","direction":"in","interface":"","from":"10.0.0.0/8","to":"","proto":"tcp","port":"22","comment":"SSH from office network"},{"action":"allow","direction":"in","interface":"","from":"10.0.0.0/8","to":"","proto":"tcp","port":"445","comment":"SMB file shares"},{"action":"allow","direction":"in","interface":"","from":"","to":"","proto":"udp","port":"5353","comment":"mDNS"}]}']]></default>
      <summary>"Office" profile</summary>
    </key>

    <key name="profile-public" type="s">
      <default><![CDATA['{"defaults":{"incoming":"deny","outgoing":"allow"},"rules":[]}']]></default>
      <summary>"Public" profile (all incoming traffic blocked)</summary>
    </key>

    <!-- Status refresh interval in seconds -->
    <key name="refresh-interval" type="i">
      <default>30</default>
      <range min="10" max="600"/>
      <summary>Status refresh interval (seconds)</summary>
    </key>
  </schema>
</schemalist>
